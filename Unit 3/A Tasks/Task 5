# Matrix Operations using Nested Lists

matrix1 = [[1, 2], [3, 4]]
matrix2 = [[5, 6], [7, 8]]

print("First Matrix:")
for row in matrix1:
    print(row)

print("Second Matrix:")
for row in matrix2:
    print(row)

# Addition
addition = []
for i in range(2):
    row = []
    for j in range(2):
        row.append(matrix1[i][j] + matrix2[i][j])
    addition.append(row)

print("Matrix Addition:")
for row in addition:
    print(row)

# Subtraction
subtraction = []
for i in range(2):
    row = []
    for j in range(2):
        row.append(matrix1[i][j] - matrix2[i][j])
    subtraction.append(row)

print("Matrix Subtraction:")
for row in subtraction:
    print(row)

# Multiplication
multiplication = []
for i in range(2):
    row = []
    for j in range(2):
        sum = 0
        for k in range(2):
            sum += matrix1[i][k] * matrix2[k][j]
        row.append(sum)
    multiplication.append(row)

print("Matrix Multiplication:")
for row in multiplication:
    print(row)
