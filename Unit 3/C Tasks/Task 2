# Set Membership Testing and Methods

my_set = {10, 20, 30, 40}

print("Original Set:", my_set)

# Membership Testing
print("Is 20 present?", 20 in my_set)
print("Is 50 present?", 50 in my_set)

# Add
my_set.add(50)
print("After Add:", my_set)

# Remove
my_set.remove(20)
print("After Remove:", my_set)

# Discard
my_set.discard(30)
print("After Discard:", my_set)
